generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  GERENTE
  VENDEDOR
}
enum MotorcycleStatus {
  DISPONIVEL
  VENDIDA
  INATIVA
}
enum SaleStatus {
  ATIVA
  CANCELADA
}
enum InstallmentStatus {
  PENDENTE
  PAGA
  CANCELADA
}
model Unit {
  id String @id @default(uuid())
  name String
  code String @unique
  address String
  city String
  state String @db.Char(2)
  phone String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  managers ManagerUnit[]
  products Product[]
  images StoredImage[]
  motorcycles Motorcycle[]
  sales Sale[]
  customers Customer[]
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  username String? @unique
  phone String @default("")
  passwordHash String
  role Role
  active Boolean @default(true)
  sessionVersion Int @default(0)
  mustChangePassword Boolean @default(true)
  unitId String?
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  managerUnits ManagerUnit[]
  sales Sale[]
  customers Customer[]
  auditLogs AuditLog[]
  stockMovements StockMovement[]
  priceChanges PriceChange[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([unitId, role, active])
}
model ManagerUnit {
  userId String
  unitId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  @@id([userId, unitId])
  @@index([unitId])
}
model Customer {
  id String @id @default(uuid())
  name String
  cpf String @unique @db.Char(11)
  phone String
  email String?
  zip String @db.Char(8)
  street String
  number String
  complement String @default("")
  neighborhood String
  city String
  state String @db.Char(2)
  notes String @default("")
  active Boolean @default(true)
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sales Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([unitId, name])
  @@index([createdById])
}
model Product {
  id String @id @default(uuid())
  name String
  brand String
  model String
  description String @default("")
  imageUrl String?
  basePrice Decimal @db.Decimal(14,2)
  colors String[] @default([])
  batteryTypes String[] @default([])
  versions String[] @default([])
  active Boolean @default(true)
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  priceChanges PriceChange[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([unitId, name])
  @@index([unitId, active])
}
model StoredImage {
  id String @id @default(uuid())
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  hash String @db.Char(64)
  data Bytes
  width Int
  height Int
  size Int
  createdAt DateTime @default(now())
  @@unique([unitId, hash])
}
model ProductVariant {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  version String
  batteryType String
  color String
  colorSwatches Json @default("[]")
  price Decimal? @db.Decimal(14,2)
  imageUrl String?
  active Boolean @default(true)
  motorcycles Motorcycle[]
  batches StockBatch[]
  movements StockMovement[]
  priceChanges PriceChange[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, version, batteryType, color])
}
model StockBatch {
  id String @id @default(uuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  code String
  quantity Int
  unitCost Decimal? @db.Decimal(14,2)
  notes String @default("")
  motorcycles Motorcycle[]
  createdAt DateTime @default(now())
  @@index([variantId, createdAt])
}
model StockMovement {
  id String @id @default(uuid())
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  saleId String?
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict)
  kind String
  quantity Int
  reason String
  createdAt DateTime @default(now())
  @@index([variantId, createdAt])
}
model PriceChange {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  oldPrice Decimal @db.Decimal(14,2)
  newPrice Decimal @db.Decimal(14,2)
  reason String
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}
model Motorcycle {
  id String @id @default(uuid())
  brand String
  model String
  year Int
  color String
  imageUrl String?
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockBatchId String?
  stockBatch StockBatch? @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  chassis String? @unique
  price Decimal @db.Decimal(14,2)
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status MotorcycleStatus @default(DISPONIVEL)
  notes String @default("")
  sales Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([variantId, status])
  @@index([stockBatchId])
  @@index([unitId, status])
}
model Sale {
  id String @id @default(uuid())
  code Int @unique @default(autoincrement())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  motorcycleId String
  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sellerId String
  seller User @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  total Decimal @db.Decimal(14,2)
  financing Json?
  soldAt DateTime @db.Date
  installmentCount Int
  status SaleStatus @default(ATIVA)
  cancellationReason String?
  stockMovements StockMovement[]
  installments Installment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([unitId, soldAt])
  @@index([sellerId, soldAt])
  @@index([customerId])
}
model Installment {
  id String @id @default(uuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  number Int
  amount Decimal @db.Decimal(14,2)
  dueAt DateTime @db.Date
  paidAt DateTime? @db.Date
  status InstallmentStatus @default(PENDENTE)
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([saleId, number])
  @@index([status, dueAt])
}
model AuditLog {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  action String
  entity String
  recordId String?
  before Json?
  after Json?
  ip String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId, action, entity])
}
