{
  "name": "motos-gestao",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "admin:create": "npm run admin:create -w backend",
    "db:local": "node scripts/portable-postgres.mjs",
    "test:local": "node scripts/test-local.mjs",
    "setup": "node scripts/setup.mjs",
    "test:config": "node scripts/test-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "9.2.5",
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
